<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:compo="clr-namespace:SyntaxAlter.components"
             x:Class="SyntaxAlter.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="logo.svg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="Syntax Alter"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <compo:JqueryDependencyRemover></compo:JqueryDependencyRemover>
            <compo:JsonXmlView></compo:JsonXmlView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
